{
  "channel": "amazon",
  "name": "Amazon Seller Central Marketplace",
  "version": "2026.1",
  "title": {
    "ruleId": "amazon.v2026.1.title_max_length",
    "maxCharacters": 200,
    "minCharacters": 40,
    "frontLoadBrand": true,
    "prohibitedWords": [
      "best seller",
      "hot item",
      "free shipping",
      "top rated",
      "cheap",
      "discount",
      "100% guaranteed",
      "sale",
      "limited time",
      "n1",
      "number 1",
      "gift"
    ]
  },
  "backendSearchTerms": {
    "ruleId": "amazon.v2026.1.backend_bytes_limit",
    "maxBytes": 249,
    "allowCommas": false,
    "allowDuplication": false
  },
  "bullets": {
    "ruleId": "amazon.v2026.1.bullets_count",
    "recommendedCount": 5,
    "minCount": 5,
    "maxCharPerBullet": 250,
    "minCharPerBullet": 50,
    "capitalizeFirstWord": true,
    "allowEmojis": false,
    "allowHtml": false
  },
  "images": {
    "ruleId": "amazon.v2026.1.image_resolution",
    "minResolution": "1600x1600",
    "recommendedResolution": "2000x2000",
    "pureWhiteBackground": true,
    "requiredHexCode": "#FFFFFF",
    "frameFillPercent": 85,
    "minImageCount": 5
  },
  "ftcCompliance": {
    "ruleId": "amazon.v2026.1.ftc_truth_in_advertising",
    "enforceClaimGuard": true
  },
  "requiredAttributes": ["name", "price", "stock", "description", "category", "sku", "specs"]
}
