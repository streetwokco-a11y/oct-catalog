{
  "channel": "nykaa",
  "name": "Nykaa Merchant Network",
  "version": "2026.1",
  "title": {
    "ruleId": "nykaa.v2026.1.title_formula",
    "formula": "[Brand] [Product Name] - [Shade] | [Key Ingredient]",
    "maxCharacters": 140,
    "minCharacters": 20,
    "prohibitedWords": ["100% cure", "instant miracle", "cheap"]
  },
  "backendSearchTerms": {
    "ruleId": "nykaa.v2026.1.keywords",
    "maxBytes": 500,
    "allowCommas": true
  },
  "bullets": {
    "ruleId": "nykaa.v2026.1.bullets_count",
    "recommendedCount": 5,
    "minCount": 3
  },
  "images": {
    "ruleId": "nykaa.v2026.1.image_resolution",
    "minResolution": "1000x1000",
    "pureWhiteBackground": true,
    "requireShadeSwatch": true,
    "minImageCount": 3
  },
  "requiredAttributes": [
    "name",
    "price",
    "stock",
    "Shade",
    "Ingredients",
    "AuthenticityCertification"
  ]
}
