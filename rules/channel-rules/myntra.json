{
  "channel": "myntra",
  "name": "Myntra Partner Portal",
  "version": "2026.1",
  "title": {
    "ruleId": "myntra.v2026.1.title_formula",
    "formula": "[Brand] [Product Name] Apparel",
    "maxCharacters": 120,
    "minCharacters": 20
  },
  "backendSearchTerms": {
    "ruleId": "myntra.v2026.1.keywords",
    "maxBytes": 500,
    "allowCommas": true
  },
  "bullets": {
    "ruleId": "myntra.v2026.1.bullets_count",
    "recommendedCount": 5,
    "minCount": 3
  },
  "images": {
    "ruleId": "myntra.v2026.1.image_aspect_ratio",
    "minResolution": "1080x1440",
    "recommendedResolution": "1500x2000",
    "aspectRatio": "3:4",
    "nearWhiteBackground": true,
    "rejectPureWhite": true,
    "minImageCount": 4
  },
  "requiredAttributes": [
    "name",
    "price",
    "stock",
    "SizeMatrix",
    "FabricComposition",
    "CareInstructions"
  ]
}
